# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_analysis
DB_USER=postgres
DB_PASSWORD=

GOOGLE_SERVICE_ACCOUNT_FILE=service.json
GOOGLE_DELEGATED_USER=
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Sheet1

# ---- API ----
# Seconds between automatic background syncs from the Google Sheet.
SYNC_INTERVAL_SECONDS=60
# Comma-separated list of allowed CORS origins, or "*" for any.
CORS_ALLOW_ORIGINS=*
# Host/port uvicorn binds to. Read by start.bat for production deploys.
API_HOST=0.0.0.0
API_PORT=8000
